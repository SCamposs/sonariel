{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonariel",
  "version": "0.1.0",
  "identifier": "app.sonariel.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "Sonariel", "width": 1440, "height": 940, "minWidth": 1000, "minHeight": 700, "backgroundColor": "#130f18" }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; media-src http://127.0.0.1:*; script-src 'self'" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "resources": { "../build/runtime/sonariel-core/": "runtime/" }, "windows": { "nsis": { "installMode": "currentUser", "languages": ["PortugueseBR", "English"] } } }
}
